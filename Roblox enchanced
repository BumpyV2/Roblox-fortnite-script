-- ── Permission gate ───────────────────────────────────────────────────────────
-- Server must expose ReplicatedStorage.AimTrainer_CheckPermission (RemoteFunction).
-- Returns true for approved testers / private sessions.
-- Falls back to solo-only when the RF is absent.
local RS     = game:GetService("ReplicatedStorage")
local permRF = RS:FindFirstChild("AimTrainer_CheckPermission")

local function checkPermission()
    if permRF and permRF:IsA("RemoteFunction") then
        local ok, result = pcall(function() return permRF:InvokeServer() end)
        return ok and result == true
    end
    return #Players:GetPlayers() == 1
end

if not checkPermission() then
    warn("[AimTrainer] Permission denied — not in a private session or approved-tester list.")
    return
end

