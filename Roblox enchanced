-- ── ESP helpers ───────────────────────────────────────────────────────────────
local function newLine(color, thickness)
    local l = Drawing.new("Line")
    l.Color     = color
    l.Thickness = thickness or 1
    l.Visible   = false
    return l
end

local function newText(color, size)
    local t = Drawing.new("Text")
    t.Color    = color
    t.Size     = size or 13
    t.Font     = Drawing.Fonts.UI
    t.Outline  = true
    t.Visible  = false
    return t
end

local function getOrCreateESP(char, isBot)
    if espPool[char] then return espPool[char] end
    local boxCol  = isBot and cfg.espBotColor or cfg.espBoxColor
    local entry = {
        -- Box: top, bottom, left, right
        box   = {
            newLine(boxCol, 1.5),
            newLine(boxCol, 1.5),
            newLine(boxCol, 1.5),
            newLine(boxCol, 1.5),
        },
        name  = newText(cfg.espNameColor, 13),
        hpBg  = newLine(Color3.fromRGB(0, 0, 0), 3),
        hpFill= newLine(Color3.fromRGB(80, 255, 80), 3),
    }
    espPool[char] = entry
    return entry
end

local function removeESP(char)
    local e = espPool[char]
    if not e then return end
    for _, l in ipairs(e.box) do l:Remove() end
    e.name:Remove()
    e.hpBg:Remove()
    e.hpFill:Remove()
    espPool[char] = nil
end

local function hideESP(e)
    for _, l in ipairs(e.box) do l.Visible = false end
    e.name.Visible  = false
    e.hpBg.Visible  = false
    e.hpFill.Visible= false
end

local function drawESP(e, char, isBot)
    local root = getRoot(char)
    local hum  = getHumanoid(char)
    if not root or not hum then hideESP(e); return end

    -- Bounding box via Head + HumanoidRootPart
    local head = getPart(char, "Head")
    if not head then hideESP(e); return end

    local topWorld = head.Position + Vector3.new(0, head.Size.Y / 2 + 0.1, 0)
    local botWorld = root.Position - Vector3.new(0, 2.5, 0)

    local topSP = screenPos(topWorld)
    local botSP = screenPos(botWorld)
    if not topSP or not botSP then hideESP(e); return end

    local h    = math.abs(botSP.Y - topSP.Y)
    local w    = h * 0.5
    local cx   = (topSP.X + botSP.X) / 2
    local top  = math.min(topSP.Y, botSP.Y)
    local bot  = math.max(topSP.Y, botSP.Y)
    local left = cx - w / 2
    local rght = cx + w / 2

    local tl = Vector2.new(left, top)
    local tr = Vector2.new(rght, top)
    local bl = Vector2.new(left, bot)
    local br = Vector2.new(rght, bot)

    local boxCol = isBot and cfg.espBotColor or cfg.espBoxColor
    -- top, bottom, left, right
    local sides = {
        {tl, tr}, {bl, br}, {tl, bl}, {tr, br}
    }
    for i, l in ipairs(e.box) do
        l.From    = sides[i][1]
        l.To      = sides[i][2]
        l.Color   = boxCol
        l.Visible = true
    end

    -- Name
    local displayName = char.Name
    e.name.Text     = displayName
    e.name.Position = Vector2.new(cx - e.name.TextBounds.X / 2, top - 16)
    e.name.Color    = cfg.espNameColor
    e.name.Visible  = true

    -- Health bar (left side)
    local hpFrac = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
    local barX   = left - 5
    local barTop = top
    local barBot = bot
    local barH   = barBot - barTop
    e.hpBg.From    = Vector2.new(barX, barTop)
    e.hpBg.To      = Vector2.new(barX, barBot)
    e.hpBg.Visible = true

    local fillBot  = barBot
    local fillTop  = barBot - barH * hpFrac
    local hpColor  = Color3.fromRGB(
        math.round(255 * (1 - hpFrac)),
        math.round(255 * hpFrac),
        0
    )
    e.hpFill.From    = Vector2.new(barX, fillTop)
    e.hpFill.To      = Vector2.new(barX, fillBot)
    e.hpFill.Color   = hpColor
    e.hpFill.Visible = true
end

-- ── Aim assist ────────────────────────────────────────────────────────────────
local function applyAssist(target)
    if not target then return end
    local aimPart = getAimPart(target.char)
    if not aimPart then return end

    local aimPos             = predictedPos(target.root)
    -- Override with the actual aim part position + prediction offset
    local rootVel            = target.root.AssemblyLinearVelocity
    local lead               = cfg.prediction and (cfg.predStrength / 100) * 0.5 or 0
    local predictedAimPos    = aimPart.Position + rootVel * lead

    local sDist, sp, centre  = screenDist(predictedAimPos)
    if not sp then return end
    if sDist > cfg.fovRadius then return end

    local delta = sp - centre
    local scale = (cfg.assistStrength / 100) * 0.4

    if mousemoverel then
        mousemoverel(delta.X * scale, delta.Y * scale)
    end
end

-- ── Main RenderStepped loop ───────────────────────────────────────────────────
local seenChars = {}  -- track which chars have ESP entries this frame

RunService.RenderStepped:Connect(function()
    local vp     = Camera.ViewportSize
    local centre = Vector2.new(vp.X / 2, vp.Y / 2)

    if not cfg.enabled then
        fovCircle.Visible  = false
        targetLine.Visible = false
        for char, e in pairs(espPool) do hideESP(e) end
        return
    end

    -- FOV circle
    fovCircle.Visible  = cfg.showFOV
    fovCircle.Position = centre
    fovCircle.Radius   = cfg.fovRadius

    -- Collect & categorise targets
    local targets = collectTargets()

    -- ESP pass
    seenChars = {}
    if cfg.espEnabled then
        for _, t in ipairs(targets) do
            local showThis = t.isBot and cfg.espBots or cfg.espPlayers
            if showThis then
                local e = getOrCreateESP(t.char, t.isBot)
                drawESP(e, t.char, t.isBot)
                seenChars[t.char] = true
            end
        end
    end
    -- Hide / remove ESP for chars no longer in target list
    for char, e in pairs(espPool) do
        if not seenChars[char] then
            hideESP(e)
        end
    end

    -- Nearest target
    nearest = findNearest(targets)

    -- Target line
    if cfg.showLine and nearest then
        local aimPart = getAimPart(nearest.char)
        if aimPart then
            local aimPos = predictedPos(nearest.root)
            -- Adjust for aim part offset
            local partOffset = aimPart.Position - nearest.root.Position
            local lead       = cfg.prediction and (cfg.predStrength / 100) * 0.5 or 0
            local vel        = nearest.root.AssemblyLinearVelocity
            local finalPos   = aimPart.Position + vel * lead
            local sp         = screenPos(finalPos)
            if sp then
                targetLine.Visible = true
                targetLine.From    = centre
                targetLine.To      = sp
            else
                targetLine.Visible = false
            end
        else
            targetLine.Visible = false
        end
    else
        targetLine.Visible = false
    end

    -- Aim assist
    if cfg.aimAssist then
        applyAssist(nearest)
    end
end)

-- Clean up ESP when player characters are removed
Players.PlayerRemoving:Connect(function(player)
    if player.Character then
        removeESP(player.Character)
    end
end)

-- ── Keybinds ──────────────────────────────────────────────────────────────────
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local k = input.KeyCode

    if k == cfg.toggleKey then
        cfg.enabled = not cfg.enabled
    elseif k == cfg.lineKey then
        cfg.showLine = not cfg.showLine
    elseif k == cfg.fovKey then
        cfg.showFOV = not cfg.showFOV
    elseif k == cfg.assistKey then
        cfg.aimAssist = not cfg.aimAssist
        if assistBtn then
            assistBtn.Text       = "Aim Assist: " .. (cfg.aimAssist and "ON" or "OFF")
            assistBtn.TextColor3 = cfg.aimAssist and Color3.fromRGB(100,255,100) or Color3.fromRGB(255,80,80)
        end
    elseif k == cfg.espKey then
        cfg.espEnabled = not cfg.espEnabled
        if espBtn then
            espBtn.Text       = "ESP: " .. (cfg.espEnabled and "ON" or "OFF")
            espBtn.TextColor3 = cfg.espEnabled and Color3.fromRGB(100,255,100) or Color3.fromRGB(255,80,80)
        end
    end
end)

