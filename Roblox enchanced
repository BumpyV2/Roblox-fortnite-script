-- ── Helpers ───────────────────────────────────────────────────────────────────
local function getHumanoid(char)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getPart(char, partName)
    return char and char:FindFirstChild(partName)
end

-- Choose the aim part on a character based on cfg.hitPart
local function getAimPart(char)
    if cfg.hitPart == "Head" then
        return getPart(char, "Head") or getPart(char, "HumanoidRootPart")
    elseif cfg.hitPart == "UpperTorso" then
        return getPart(char, "UpperTorso") or getPart(char, "HumanoidRootPart")
    else
        -- "Nearest": whichever visible part is closest to screen centre
        local vp     = Camera.ViewportSize
        local centre = Vector2.new(vp.X / 2, vp.Y / 2)
        local best, bestD = nil, math.huge
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and not part.Name:find("Collide") then
                local sp, on = Camera:WorldToViewportPoint(part.Position)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - centre).Magnitude
                    if d < bestD then bestD = d; best = part end
                end
            end
        end
        return best or getPart(char, "HumanoidRootPart")
    end
end

local function getRoot(char)
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso"))
end

local function sameTeam(player)
    if not cfg.filterTeam then return false end
    return player.Team ~= nil and player.Team == LocalPlayer.Team
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function isVisible(origin, targetPos, char)
    local localChar = LocalPlayer.Character
    local ex = {}
    if localChar then table.insert(ex, localChar) end
    if char      then table.insert(ex, char) end
    rayParams.FilterDescendantsInstances = ex
    local result = workspace:Raycast(origin, targetPos - origin, rayParams)
    if not result then return true end
    return char ~= nil and result.Instance:IsDescendantOf(char)
end

local function screenPos(worldPos)
    local sp, on = Camera:WorldToViewportPoint(worldPos)
    if not on then return nil end
    return Vector2.new(sp.X, sp.Y)
end

local function screenDist(worldPos)
    local vp     = Camera.ViewportSize
    local centre = Vector2.new(vp.X / 2, vp.Y / 2)
    local sp      = screenPos(worldPos)
    if not sp then return math.huge, nil, centre end
    return (sp - centre).Magnitude, sp, centre
end

-- Predict where a moving target will be given bullet travel time
-- predStrength 1-100 maps to 0-0.5s lead
local function predictedPos(root)
    if not cfg.prediction then return root.Position end
    local vel = root.AssemblyLinearVelocity  -- Roblox velocity
    local lead = (cfg.predStrength / 100) * 0.5
    return root.Position + vel * lead
end

-- ── Collect all eligible targets (players + bots) ─────────────────────────────
local function collectTargets()
    local localChar = LocalPlayer.Character
    local localRoot = getRoot(localChar)
    if not localRoot then return {} end

    local origin  = localRoot.Position
    local targets = {}

    -- Players
    if cfg.espPlayers or cfg.aimAssist or cfg.showLine then
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if sameTeam(player) then continue end
            local char = player.Character
            if not char then continue end
            local root = getRoot(char)
            if not root then continue end
            if cfg.filterAlive then
                local hum = getHumanoid(char)
                if not hum or hum.Health <= 0 then continue end
            end
            if (root.Position - origin).Magnitude > cfg.maxDistance then continue end
            if cfg.filterVisible and not isVisible(origin, root.Position, char) then continue end
            table.insert(targets, { char = char, root = root, isBot = false, player = player })
        end
    end

    -- Bots (NPC Humanoids in workspace, not belonging to any Player)
    if cfg.targetBots then
        local playerChars = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then playerChars[p.Character] = true end
        end

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Humanoid") and obj.Health > 0 then
                local char = obj.Parent
                if not char then continue end
                if char == localChar then continue end
                if playerChars[char] then continue end   -- skip real players

                local root = getRoot(char)
                if not root then continue end
                if (root.Position - origin).Magnitude > cfg.maxDistance then continue end
                if cfg.filterVisible and not isVisible(origin, root.Position, char) then continue end
                table.insert(targets, { char = char, root = root, isBot = true, hum = obj })
            end
        end
    end

    return targets
end

-- ── Find nearest target to screen centre ─────────────────────────────────────
local function findNearest(targets)
    local bestDist = math.huge
    local best     = nil

    for _, t in ipairs(targets) do
        local aimPart = getAimPart(t.char)
        if not aimPart then continue end
        local pos  = predictedPos(t.root)
        local d    = screenDist(pos)
        if d < bestDist then
            bestDist = d
            best     = t
        end
    end

    return best
end

