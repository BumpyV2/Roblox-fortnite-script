local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local function visible(part, model)
    rayParams.FilterDescendantsInstances = {camera, lp.Character}
    local o = camera.CFrame.Position
    local hit = workspace:Raycast(o, part.Position - o, rayParams)
    return hit == nil or hit.Instance:IsDescendantOf(model)
end

local function pickPart(model)
    local name = cfg.Aim.AimPart
    if name == "Random" then name = PARTS[math.random(#PARTS)] end
    return model:FindFirstChild(name) or model:FindFirstChild("HumanoidRootPart")
end

----------------------------------------------------------------------
-- hooks
----------------------------------------------------------------------
-- 1) silent aim + no spread: the game's local shot-ray builder.
--    The exported wrapper exposes no upvalues in this executor, so find the real local by
--    name + source + line (confirmed against the decompile: Weapon module, line 73).
do
    local aimFn
    for _, f in ipairs(getgc()) do
        if type(f) == "function" and islclosure(f) then
            local okn, n = pcall(debug.info, f, "n")
            if okn and n == "WRZqzZaZR99w2Lga" then
                local _, l = pcall(debug.info, f, "l")
                local _, s = pcall(debug.info, f, "s")
                if l == 73 and tostring(s):find("Weapon$") then aimFn = f break end
            end
        end
    end
    local orig
    orig = hook(aimFn, function(a1, a2)
        if not S.alive then return orig(a1, a2) end
        if cfg.Weapon.NoSpread then a1 = nil end         -- nil => exact crosshair
        local ray = orig(a1, a2)
        local t = S.target
        if cfg.Aim.SilentAim and t and t.Parent and math.random(100) <= cfg.Aim.HitChance then
            local part = pickPart(t)
            if part then
                local dir = part.Position - ray.Origin
                if dir.Magnitude > 0 then
                    S.redirected += 1
                    return Ray.new(ray.Origin, dir.Unit * ray.Direction.Magnitude)
                end
            end
        end
        return ray
    end, "WRZq shot ray")
end

-- 2) no recoil
if Kick then
    local orig
    orig = hook(Kick.kick, function(...)
        if S.alive and cfg.Weapon.NoRecoil then return end
        return orig(...)
    end, "Kickback.kick")
end
if Shake then
    local orig
    orig = hook(Shake.ShakeOnce, function(...)
        if S.alive and cfg.Weapon.NoRecoil then return end
        return orig(...)
    end, "CameraShake.ShakeOnce")
end

-- 3) cooldown / fire rate (client-side checks only)
if Weapon then
    local oc
    oc = hook(Weapon.UpdateCooldown, function(self, ...)
        if S.alive and cfg.Weapon.NoCooldown then return true end
        return oc(self, ...)
    end, "Weapon.UpdateCooldown")
    local oi
    oi = hook(Weapon.GetAutoAttackInterval, function(self, ...)
        local r = oi(self, ...)
        if S.alive and type(r) == "number" then return r * cfg.Weapon.FireRateScale end
        return r
    end, "Weapon.GetAutoAttackInterval")
end

