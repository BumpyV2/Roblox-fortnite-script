local function tryRequire(path)
    local ok, m = pcall(function()
        local inst = RS
        for _, n in ipairs(path) do inst = inst:WaitForChild(n, 5) end
        return require(inst)
    end)
    if ok then return m end
    warn("[hub] require failed: " .. table.concat(path, ".") .. " -> " .. tostring(m))
end

local Weapon = tryRequire({"Client", "Combat", "WeaponController", "Weapon"})
local WC     = tryRequire({"Client", "Combat", "WeaponController"})
local Kick   = tryRequire({"Client", "Camera", "Kickback"})
local Shake  = tryRequire({"Client", "Camera", "CameraShake"})

local function hook(fn, repl, label)
    if type(fn) ~= "function" then warn("[hub] cannot hook " .. label); return end
    local ok, orig = pcall(hookfunction, fn, repl)
    if ok and orig then
        hooks[#hooks + 1] = {fn = fn, orig = orig}
        return orig
    end
    warn("[hub] hook failed: " .. label .. " -> " .. tostring(orig))
end

