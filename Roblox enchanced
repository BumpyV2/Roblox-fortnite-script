-- ── Helpers ───────────────────────────────────────────────────────────────────
local function getRoot(char)
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso"))
end

local function getHumanoid(char)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function sameTeam(player)
    if not cfg.filterTeam then return false end
    return player.Team ~= nil and player.Team == LocalPlayer.Team
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function isVisible(origin, targetPos, char)
    local localChar = LocalPlayer.Character
    local ex = {}
    if localChar then table.insert(ex, localChar) end
    if char      then table.insert(ex, char) end
    rayParams.FilterDescendantsInstances = ex
    local dir    = targetPos - origin
    local result = workspace:Raycast(origin, dir, rayParams)
    if not result then return true end
    return char ~= nil and result.Instance:IsDescendantOf(char)
end

-- Returns screen-space distance from viewport centre + the screen Vector2
local function screenDist(worldPos)
    local vp     = Camera.ViewportSize
    local centre = Vector2.new(vp.X / 2, vp.Y / 2)
    local sp, onScreen = Camera:WorldToViewportPoint(worldPos)
    if not onScreen then return math.huge, nil end
    local s2 = Vector2.new(sp.X, sp.Y)
    return (s2 - centre).Magnitude, s2, centre
end

-- ── Target selection ──────────────────────────────────────────────────────────
local function findNearest()
    local localChar = LocalPlayer.Character
    local localRoot = getRoot(localChar)
    if not localRoot then return nil end

    local origin   = localRoot.Position
    local bestDist = math.huge
    local best     = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if sameTeam(player)      then continue end

        local char = player.Character
        if not char then continue end
        local root = getRoot(char)
        if not root then continue end

        if cfg.filterAlive then
            local hum = getHumanoid(char)
            if not hum or hum.Health <= 0 then continue end
        end

        if (root.Position - origin).Magnitude > cfg.maxDistance then continue end

        if cfg.filterVisible and not isVisible(origin, root.Position, char) then continue end

        local sDist = screenDist(root.Position)
        if sDist < bestDist then
            bestDist = sDist
            best     = char
        end
    end

    return best
end

-- ── Aim assist (mousemoverel) ─────────────────────────────────────────────────
-- We deliberately avoid writing Camera.CFrame directly — that fights the game's
-- camera scripts and produces the "doesn't work" symptom.  Instead we feed a
-- relative mouse delta which the native camera controller picks up naturally.
local function applyAssist(targetChar)
    if not targetChar then return end
    local root = getRoot(targetChar)
    if not root then return end

    local sDist, sp, centre = screenDist(root.Position)
    if not sp then return end
    if sDist > cfg.fovRadius then return end   -- only targets inside FOV

    -- Delta from screen centre to target, scaled by strength
    local delta = (sp - centre)
    local scale = (cfg.assistStrength / 100) * 0.4   -- tune: 0.4 max feels natural

    local dx = delta.X * scale
    local dy = delta.Y * scale

    -- mousemoverel is provided by most Roblox executors
    if mousemoverel then
        mousemoverel(dx, dy)
    end
end

-- ── RenderStepped ─────────────────────────────────────────────────────────────
RunService.RenderStepped:Connect(function()
    if not cfg.enabled then
        fovCircle.Visible  = false
        targetLine.Visible = false
        return
    end

    local vp     = Camera.ViewportSize
    local centre = Vector2.new(vp.X / 2, vp.Y / 2)

    fovCircle.Visible  = cfg.showFOV
    fovCircle.Position = centre
    fovCircle.Radius   = cfg.fovRadius

    nearest = findNearest()

    if cfg.showLine and nearest then
        local root = getRoot(nearest)
        if root then
            local _, sp = screenDist(root.Position)
            if sp then
                targetLine.Visible = true
                targetLine.From    = centre
                targetLine.To      = sp
            else
                targetLine.Visible = false
            end
        else
            targetLine.Visible = false
        end
    else
        targetLine.Visible = false
    end

    if cfg.aimAssist then
        applyAssist(nearest)
    end
end)

-- ── Keybinds ──────────────────────────────────────────────────────────────────
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local k = input.KeyCode

    if k == cfg.toggleKey then
        cfg.enabled = not cfg.enabled

    elseif k == cfg.lineKey then
        cfg.showLine = not cfg.showLine

    elseif k == cfg.fovKey then
        cfg.showFOV = not cfg.showFOV

    elseif k == cfg.assistKey then
        cfg.aimAssist = not cfg.aimAssist
        -- Update button label if the UI is already built
        if assistBtn then
            assistBtn.Text       = "Aim Assist: " .. (cfg.aimAssist and "ON" or "OFF")
            assistBtn.TextColor3 = cfg.aimAssist
                and Color3.fromRGB(100, 255, 100)
                or  Color3.fromRGB(255, 80, 80)
        end
    end
end)

