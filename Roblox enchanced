local camera = workspace.CurrentCamera
local objects = {}   -- model -> {hum, hrp, head, draw..., hl}
local PARTS = {"Head", "UpperTorso", "HumanoidRootPart"}

local function excluded(m)
    for _, n in ipairs(cfg.Exclude) do if m:FindFirstAncestor(n) then return true end end
    return false
end
local function isBot(m)
    local u = m:GetAttribute("UserId")
    return type(u) == "number" and u < 0
end
-- Teammate = same party, or same match team (TDM sets Team=Blue/Red on you and on every model;
-- real players carry it on the Player object). "Player" is the free-for-all label, not a team.
local function teamOf(m)
    local t = m:GetAttribute("Team")
    if t == nil then
        local p = Players:GetPlayerFromCharacter(m)
        t = p and p:GetAttribute("Team")
    end
    return t
end
local function isTeam(m)
    local party = lp:GetAttribute("Party")
    if party ~= nil and m:GetAttribute("Party") == party then return true end
    local mine, theirs = lp:GetAttribute("Team"), teamOf(m)
    return theirs ~= nil and theirs ~= "Player" and theirs == mine
end

local function newDraw(class, props)
    if not Drawing then return nil end
    local ok, d = pcall(Drawing.new, class)
    if not ok then return nil end
    for k, v in pairs(props or {}) do d[k] = v end
    drawings[#drawings + 1] = d
    return d
end

local function removeDraw(d)
    if not d then return end
    pcall(function() d.Visible = false; d:Remove() end)
end

local function clearObj(m)
    local o = objects[m]
    if not o then return end
    for _, k in ipairs({"box", "name", "dist", "hpBg", "hp", "tracer"}) do removeDraw(o[k]) end
    if o.hl then o.hl:Destroy() end
    objects[m] = nil
end

