-- ── Permission gate ──────────────────────────────────────────────────────────
-- The server must expose a RemoteFunction called "AimTrainer_CheckPermission"
-- inside ReplicatedStorage.  It should return true for the local player when
-- they are in a private training session or are on the approved-tester list.
-- If the RemoteFunction is absent we fall back to a solo-only check.
local RS = game:GetService("ReplicatedStorage")
local permRF = RS:FindFirstChild("AimTrainer_CheckPermission")

local function checkPermission()
    if permRF and permRF:IsA("RemoteFunction") then
        local ok, result = pcall(function()
            return permRF:InvokeServer()
        end)
        return ok and result == true
    end
    -- Fallback: allow only when the server has exactly 1 player (private session)
    return #Players:GetPlayers() == 1
end

if not checkPermission() then
    warn("[AimTrainer] Permission denied — not in a private session or approved tester list.")
    return
end

