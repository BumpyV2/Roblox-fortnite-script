local fovCircle = newDraw("Circle", {Thickness = 1, NumSides = 64, Filled = false, Color = Color3.new(1, 1, 1), Transparency = 0.6})
local firing = false
local function setFire(on)
    if on == firing then return end
    firing = on
    if mouse1press and mouse1release then
        if on then mouse1press() else mouse1release() end
    else
        local loc = UIS:GetMouseLocation()
        pcall(function() VIM:SendMouseButtonEvent(loc.X, loc.Y, 0, on, game, 0) end)
    end
end

conns[#conns + 1] = RunService.RenderStepped:Connect(function()
    camera = workspace.CurrentCamera
    local vp = camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    local A, V = cfg.Aim, cfg.Visuals

    if fovCircle then
        fovCircle.Visible = A.SilentAim and A.ShowFOV
        fovCircle.Position = center
        fovCircle.Radius = A.FOV
    end

    local best, bestD = nil, A.FOV
    for m, o in pairs(objects) do
        if not m.Parent then
            clearObj(m)
        else
            local alive = o.hum.Health > 0
            local d3 = myRoot and (o.hrp.Position - myRoot.Position).Magnitude or 0
            local bot, team = isBot(m), isTeam(m)
            local col = team and V.TeamColor or (bot and V.BotColor or V.PlayerColor)

            -- ESP
            local show = V.ESP and alive and d3 <= V.MaxDistance
            local top, bot2, onScreen = nil, nil, false
            if show then
                top = camera:WorldToViewportPoint(o.head.Position + Vector3.new(0, 0.7, 0))
                bot2 = camera:WorldToViewportPoint(o.hrp.Position - Vector3.new(0, 3, 0))
                onScreen = top.Z > 0 and bot2.Z > 0
            end
            local on = show and onScreen
            local h = on and (bot2.Y - top.Y) or 0
            local w = h * 0.55
            local x = on and (top.X - w / 2) or 0
            if o.box then
                o.box.Visible = on and V.Boxes
                if o.box.Visible then o.box.Position = Vector2.new(x, top.Y); o.box.Size = Vector2.new(w, h); o.box.Color = col end
            end
            if o.name then
                o.name.Visible = on and V.Names
                if o.name.Visible then
                    o.name.Position = Vector2.new(top.X, top.Y - 16)
                    o.name.Text = (bot and "[BOT] " or "") .. m.Name
                    o.name.Color = col
                end
            end
            if o.dist then
                o.dist.Visible = on and V.Distance
                if o.dist.Visible then
                    o.dist.Position = Vector2.new(top.X, bot2.Y + 2)
                    o.dist.Text = string.format("%dm", d3)
                    o.dist.Color = Color3.new(1, 1, 1)
                end
            end
            local hpOn = on and V.Health
            if o.hpBg then
                o.hpBg.Visible = hpOn
                o.hp.Visible = hpOn
                if hpOn then
                    local frac = math.clamp(o.hum.Health / math.max(o.hum.MaxHealth, 1), 0, 1)
                    o.hpBg.Position = Vector2.new(x - 6, top.Y); o.hpBg.Size = Vector2.new(3, h)
                    o.hp.Position = Vector2.new(x - 6, top.Y + h * (1 - frac)); o.hp.Size = Vector2.new(3, h * frac)
                    o.hp.Color = Color3.fromRGB(255 * (1 - frac), 255 * frac, 60)
                end
            end
            if o.tracer then
                o.tracer.Visible = on and V.Tracers
                if o.tracer.Visible then
                    o.tracer.From = Vector2.new(vp.X / 2, vp.Y)
                    o.tracer.To = Vector2.new(bot2.X, bot2.Y)
                    o.tracer.Color = col
                end
            end
            -- chams
            if V.Chams and show then
                if not o.hl then
                    o.hl = Instance.new("Highlight")
                    o.hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    o.hl.FillTransparency = 0.65
                    o.hl.Adornee = m
                    o.hl.Parent = chamFolder
                end
                o.hl.FillColor, o.hl.OutlineColor = col, col
            elseif o.hl then
                o.hl:Destroy(); o.hl = nil
            end

            -- target selection
            if A.SilentAim and alive and d3 <= A.MaxDistance
                and ((bot and A.TargetBots) or (not bot and A.TargetPlayers))
                and not (A.TeamCheck and team) then
                local part = m:FindFirstChild(A.AimPart == "Random" and "Head" or A.AimPart) or o.hrp
                local sp, vis = camera:WorldToViewportPoint(part.Position)
                if vis and sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d < bestD and (not A.WallCheck or visible(part, m)) then best, bestD = m, d end
                end
            end
        end
    end
    S.target = best
    S.targetDist = bestD

    -- auto-fire: only when the chosen target sits near the crosshair
    setFire(A.AutoFire and best ~= nil and bestD <= A.AutoFireRadius)
end)

-- Movement: the game rewrites Humanoid.WalkSpeed itself (MovementUtils.modifyWalkSpeed on crouch /
-- slide / knocked) and eases Humanoid.JumpHeight (not JumpPower) back after every jump. So we track
-- the "natural" value the game last wrote and re-apply natural * mult on top of it each frame.
local nat, last, lastHum = {}, {}, nil
local function applyMod(hum, prop, on, mult, cap)
    local cur = hum[prop]
    if last[prop] == nil or math.abs(cur - last[prop]) > 1e-3 then nat[prop] = cur end   -- game changed it
    if on then
        local v = nat[prop] * math.min(mult, cap)
        hum[prop] = v
        last[prop] = v
    elseif last[prop] then
        hum[prop] = nat[prop]
        last[prop] = nil
    end
end
local function restoreMods(hum)
    for prop in pairs(last) do pcall(function() hum[prop] = nat[prop] end) end
    last = {}
end

conns[#conns + 1] = RunService.Heartbeat:Connect(function()
    -- infinite ammo: refill the equipped weapon's client counter
    if cfg.Weapon.InfiniteAmmo and WC then
        local ok, eq = pcall(WC.getEquipped)
        S.equipped = ok and type(eq) == "table"
        if S.equipped and eq.Config and eq.Config.Ammo and type(eq.Ammo) == "number" then
            local mag = eq.Config.Ammo.MagazineSize
            if mag and eq.Ammo < mag then
                if pcall(function() eq.Ammo = mag end) then S.refills = (S.refills or 0) + 1 end
            end
        end
    end
    if cfg.Weapon.AutoReload and WC then
        local ok, eq = pcall(WC.getEquipped)
        if ok and type(eq) == "table" and eq.Config and eq.Config.Ammo
            and type(eq.Ammo) == "number" and eq.Ammo <= 0 then
            pcall(eq.Reload, eq)   -- game guards against double reloads itself
        end
    end
    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if hum ~= lastHum then nat, last, lastHum = {}, {}, hum end
    if hum then
        local M = cfg.Misc
        applyMod(hum, "WalkSpeed", M.Speed, M.SpeedMult, M.SpeedCap)
        applyMod(hum, hum.UseJumpPower and "JumpPower" or "JumpHeight", M.Jump, M.JumpMult, M.JumpCap)
    end
end)

