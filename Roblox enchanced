local Unload
conns[#conns + 1] = UIS.InputBegan:Connect(function(i, gp)
    if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local name = i.KeyCode.Name
    if rebinding then
        local r = rebinding
        rebinding = nil
        if name ~= "Escape" then
            if r.key then
                cfg.Keys[r.key] = name
            elseif name == "Backspace" or name == "Delete" then
                cfg.Binds[r.id] = nil
            else
                for id, k in pairs(cfg.Binds) do if k == name then cfg.Binds[id] = nil end end  -- one action per key
                cfg.Binds[r.id] = name
            end
        end
        refreshChips()
        return
    end
    if UIS:GetFocusedTextBox() then return end
    local K = cfg.Keys
    if name == K.Menu then gui.Enabled = not gui.Enabled
    elseif name == K.Unload then Unload()
    else
        for id, key in pairs(cfg.Binds) do
            if key == name and actions[id] then actions[id]() end
        end
    end
end)

function Unload()
    S.alive = false                       -- every hook passes straight through from here on
    setFire(false)
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    for _, h in ipairs(hooks) do
        if restorefunction then pcall(restorefunction, h.fn) end
    end
    for m in pairs(objects) do clearObj(m) end
    for _, d in ipairs(drawings) do removeDraw(d) end
    if lastHum then restoreMods(lastHum) end
    gui:Destroy()
    chamFolder:Destroy()
    genv.__HUB = nil
end

genv.__HUB = {Config = cfg, State = S, Unload = Unload}
print(("[hub] loaded. hooks: %d, models: %d. menu key: %s"):format(#hooks, (function() local n = 0 for _ in pairs(objects) do n += 1 end return n end)(), cfg.Keys.Menu))
