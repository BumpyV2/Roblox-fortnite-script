-- ── Helper: get character root ───────────────────────────────────────────────
local function getRoot(character)
    return character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso"))
end

local function getHumanoid(character)
    return character and character:FindFirstChildOfClass("Humanoid")
end

-- ── Helper: team check ───────────────────────────────────────────────────────
local function sameTeam(player)
    if not cfg.filterTeam then return false end
    return player.Team ~= nil and player.Team == LocalPlayer.Team
end

-- ── Helper: visibility raycast ───────────────────────────────────────────────
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function isVisible(origin, targetPos, character)
    local localChar = LocalPlayer.Character
    local excludeList = {}
    if localChar then table.insert(excludeList, localChar) end
    if character then table.insert(excludeList, character) end
    rayParams.FilterDescendantsInstances = excludeList

    local dir    = (targetPos - origin)
    local result = workspace:Raycast(origin, dir, rayParams)
    -- If nothing was hit, or the hit is part of the target character, it's visible
    if not result then return true end
    if character and result.Instance:IsDescendantOf(character) then return true end
    return false
end

-- ── Helper: screen-space distance from centre ────────────────────────────────
local function screenDist(worldPos)
    local vp     = Camera.ViewportSize
    local centre = Vector2.new(vp.X / 2, vp.Y / 2)
    local sp, onScreen = Camera:WorldToViewportPoint(worldPos)
    if not onScreen then return math.huge, nil end
    local s2 = Vector2.new(sp.X, sp.Y)
    return (s2 - centre).Magnitude, s2
end

-- ── Find nearest eligible target ─────────────────────────────────────────────
local function findNearest()
    local localChar = LocalPlayer.Character
    local localRoot = getRoot(localChar)
    if not localRoot then return nil end

    local origin      = localRoot.Position
    local bestDist    = math.huge
    local bestTarget  = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if sameTeam(player) then continue end

        local char = player.Character
        if not char then continue end

        local root = getRoot(char)
        if not root then continue end

        -- Alive filter
        if cfg.filterAlive then
            local hum = getHumanoid(char)
            if not hum or hum.Health <= 0 then continue end
        end

        -- Distance filter (world-space)
        local worldDist = (root.Position - origin).Magnitude
        if worldDist > cfg.maxDistance then continue end

        -- Visibility filter
        if cfg.filterVisible and not isVisible(origin, root.Position, char) then continue end

        -- Closest by screen-space distance from centre (within FOV circle)
        local sDist, _ = screenDist(root.Position)
        if sDist < bestDist then
            bestDist   = sDist
            bestTarget = char
        end
    end

    return bestTarget
end

-- ── Aim assist ───────────────────────────────────────────────────────────────
local function applyAssist(targetChar)
    if not targetChar then return end
    local root = getRoot(targetChar)
    if not root then return end

    local sDist, sp = screenDist(root.Position)
    if not sp then return end
    if sDist > cfg.fovRadius then return end   -- only inside FOV

    -- Move the camera CF slightly toward the target
    local currentCF  = Camera.CFrame
    local targetCF   = CFrame.new(currentCF.Position, root.Position)
    Camera.CFrame    = currentCF:Lerp(targetCF, cfg.assistStrength)
end

-- ── RenderStepped loop ───────────────────────────────────────────────────────
RunService.RenderStepped:Connect(function()
    if not cfg.enabled then
        fovCircle.Visible  = false
        targetLine.Visible = false
        return
    end

    local vp     = Camera.ViewportSize
    local centre = Vector2.new(vp.X / 2, vp.Y / 2)

    -- FOV circle
    fovCircle.Visible = cfg.showFOV
    fovCircle.Position = centre
    fovCircle.Radius   = cfg.fovRadius

    -- Nearest target
    nearest = findNearest()

    -- Target line
    if cfg.showLine and nearest then
        local root = getRoot(nearest)
        if root then
            local _, sp = screenDist(root.Position)
            if sp then
                targetLine.Visible = true
                targetLine.From    = centre
                targetLine.To      = sp
            else
                targetLine.Visible = false
            end
        else
            targetLine.Visible = false
        end
    else
        targetLine.Visible = false
    end

    -- Aim assist
    if cfg.aimAssist then
        applyAssist(nearest)
    end
end)

-- ── Keybinds ─────────────────────────────────────────────────────────────────
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local k = input.KeyCode

    if k == cfg.toggleKey then
        cfg.enabled = not cfg.enabled

    elseif k == cfg.lineKey then
        cfg.showLine = not cfg.showLine

    elseif k == cfg.fovKey then
        cfg.showFOV = not cfg.showFOV
        fovCircle.Visible = cfg.showFOV and cfg.enabled

    elseif k == cfg.assistKey then
        cfg.aimAssist = not cfg.aimAssist
        if settingsUI then
            local assistBtn = settingsUI:FindFirstChild("AssistToggle", true)
            if assistBtn then
                assistBtn.Text = "Aim Assist: " .. (cfg.aimAssist and "ON" or "OFF")
                assistBtn.TextColor3 = cfg.aimAssist
                    and Color3.fromRGB(100, 255, 100)
                    or  Color3.fromRGB(255, 80, 80)
            end
        end
    end
end)

