local function toggle(page, label, t, k)
    local b = mk("TextButton", {Size = UDim2.new(1, -8, 0, 26), BackgroundColor3 = C.row, BorderSizePixel = 0,
        Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false}, page)
    mk("UIPadding", {PaddingLeft = UDim.new(0, 8)}, b)
    local function refresh()
        b.Text = label .. ":  " .. (t[k] and "ON" or "OFF")
        b.TextColor3 = t[k] and C.accent or C.dim
    end
    refresh()
    local function flip() t[k] = not t[k]; refresh() end
    b.MouseButton1Click:Connect(flip)
    addBind(b, label, flip)
end
local function slider(page, label, t, k, mn, mx, step)
    local row = mk("Frame", {Size = UDim2.new(1, -8, 0, 38), BackgroundColor3 = C.row, BorderSizePixel = 0}, page)
    local lab = mk("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, -10, 0, 16), Position = UDim2.fromOffset(8, 2),
        Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left}, row)
    local bar = mk("Frame", {Position = UDim2.fromOffset(8, 24), Size = UDim2.new(1, -16, 0, 6), BackgroundColor3 = C.bar,
        BorderSizePixel = 0}, row)
    local fill = mk("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.accent, BorderSizePixel = 0}, bar)
    local function set(v)
        v = math.clamp(math.floor(v / step + 0.5) * step, mn, mx)
        t[k] = v
        lab.Text = label .. ":  " .. fmt(v)
        fill.Size = UDim2.new((v - mn) / (mx - mn), 0, 1, 0)
    end
    set(t[k])
    local drag = false
    local function fromX(x) set(mn + (mx - mn) * math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)) end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true; fromX(i.Position.X) end
    end)
    conns[#conns + 1] = UIS.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.MouseMovement then fromX(i.Position.X) end
    end)
    conns[#conns + 1] = UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
    end)
end
local function cycle(page, label, t, k, options)
    local b = mk("TextButton", {Size = UDim2.new(1, -8, 0, 26), BackgroundColor3 = C.row, BorderSizePixel = 0,
        Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false}, page)
    mk("UIPadding", {PaddingLeft = UDim.new(0, 8)}, b)
    local function refresh() b.Text = label .. ":  " .. tostring(t[k]) end
    refresh()
    local function nextOpt()
        local idx = table.find(options, t[k]) or 0
        t[k] = options[(idx % #options) + 1]
        refresh()
    end
    b.MouseButton1Click:Connect(nextOpt)
    addBind(b, label, nextOpt)
end

