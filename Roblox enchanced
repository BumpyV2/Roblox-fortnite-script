local function addModel(hum)
    local m = hum.Parent
    if not m or not m:IsA("Model") or objects[m] or m == lp.Character or excluded(m) then return end
    local hrp = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:WaitForChild("HumanoidRootPart", 3)
